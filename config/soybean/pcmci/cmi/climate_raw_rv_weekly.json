{
  "name": "soybean_climate_rv_weekly_cmi",
  "data": {
    "path": "data/weekly/soybean_raw.csv",
    "date_column": "date",
    "drop_columns": []
  },
  "features": {
    "include_groups": [
      "climate",
      "rv"
    ],
    "include_columns": [],
    "exclude_columns": []
  },
  "dependence": {
    "method": "cmi",
    "params": {
      "k": 5,
      "significance": "shuffle_test",
      "sig_samples": 200,
      "use_gpu": true
    }
  },
  "pcmci": {
    "tau_min": 1,
    "tau_max": 16,
    "pc_alpha": 0.2,
    "alpha_level": 0.05,
    "fdr_method": "fdr_bh",
    "max_conds_dim": null,
    "max_combinations": 1,
    "max_conds_py": null,
    "max_conds_px": null
  },
  "output": {
    "directory": "benchmark",
    "max_links": 10,
    "save_tigramite_plots": true,
    "save_networkx_plot": true,
    "run_name": "climate_rv"
  }
}
