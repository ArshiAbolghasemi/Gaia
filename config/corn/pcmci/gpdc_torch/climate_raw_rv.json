{
  "name": "corn_climate_raw_rv_gpdc_torch",
  "data": {
    "path": "data/weekly/corn_raw.csv",
    "date_column": "date",
    "drop_columns": []
  },
  "features": {
    "include_groups": [
      "climate_raw",
      "rv"
    ],
    "include_columns": [],
    "exclude_columns": []
  },
  "dependence": {
    "method": "gpdc_torch",
    "params": {
      "significance": "analytic",
      "sig_samples": 200
    }
  },
  "pcmci": {
    "tau_min": 1,
    "tau_max": 16,
    "pc_alpha": 0.2,
    "alpha_level": 0.05,
    "fdr_method": "fdr_bh",
    "max_conds_dim": null,
    "max_combinations": 1,
    "max_conds_py": null,
    "max_conds_px": null
  },
  "output": {
    "directory": "benchmark",
    "run_name": "climate_raw_rv",
    "max_links": 10,
    "save_tigramite_plots": true,
    "save_networkx_plot": true
  }
}
